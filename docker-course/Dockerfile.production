FROM node:24-bookworm AS dependencies
WORKDIR /app
RUN npm install --global pnpm@12.11.2
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile --prod

FROM dependencies AS build
COPY . .
RUN pnpm run build

FROM build AS dev
RUN chown -R node:node /app
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]

FROM node:24-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=dependencies --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/public ./public
COPY --chown=node:node package.json VERSION message.txt server.mjs ./
COPY --chown=node:node lib ./lib
COPY --chown=node:node scripts/init.mjs scripts/notes.mjs scripts/healthcheck.mjs scripts/memory.mjs scripts/crash.mjs ./scripts/
USER node
EXPOSE 3000
CMD ["node", "server.mjs"]
