<% layout("./layout") %>
<div class="mx-auto max-w-3xl px-4 py-12">
  <div class="rounded-lg border border-gray-200 bg-white p-8 shadow-sm">
    <div class="flex flex-wrap items-center gap-8">
      <img class="w-40" src="/images/app.png" alt="Hexlet">
      <div>
        <p class="text-3xl font-bold">Привет от Хекслета!</p>
        <hr class="my-4 border-gray-200">
        <% if (it.serverMessage) { %>
        <p class="text-lg">Приложение запущено и передает сообщение: <%~ it.serverMessage %></p>
        <% } else { %>
        <p class="text-lg">Приложение запущено, но сообщение сервера не установлено!</p>
        <% } %>
      </div>
    </div>
  </div>
</div>
